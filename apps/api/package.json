{
  "name": "@crypto-wallet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@crypto-wallet/cache": "workspace:*",
    "@crypto-wallet/config": "workspace:*",
    "@crypto-wallet/ledger-core": "workspace:*",
    "@crypto-wallet/shared-types": "workspace:*",
    "@crypto-wallet/storage": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@simplewebauthn/server": "^13.3.3",
    "fastify": "^5.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  }
}
