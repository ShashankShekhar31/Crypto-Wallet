{
  "openapi": "3.0.3",
  "info": {
    "title": "Crypto Wallet API",
    "description": "Security-first Crypto Wallet API",
    "version": "0.1.0"
  },
  "components": { "schemas": {} },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Get API health status",
        "tags": ["health"],
        "description": "Returns the current health and service status of the Crypto Wallet API.",
        "responses": { "200": { "description": "Default Response" } }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Authenticate with email and password",
        "tags": ["auth"],
        "description": "Authenticates an identity account, creates a session, and returns a refresh token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "description": "Account email address" },
                  "password": {
                    "type": "string",
                    "description": "Account password",
                    "format": "password"
                  },
                  "deviceId": { "type": "string", "description": "Registered device identifier" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Authentication successful",
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "userId": { "type": "string", "format": "uuid" },
                        "sessionId": { "type": "string", "format": "uuid" },
                        "refreshToken": { "type": "string" }
                      },
                      "required": ["userId", "sessionId", "refreshToken"]
                    },
                    "requestId": { "type": "string" }
                  },
                  "required": ["data", "requestId"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid login request",
            "content": {
              "application/json": { "schema": { "description": "Invalid login request" } }
            }
          },
          "401": {
            "description": "Invalid credentials or invalid device",
            "content": {
              "application/json": {
                "schema": { "description": "Invalid credentials or invalid device" }
              }
            }
          },
          "403": {
            "description": "Identity account is not active",
            "content": {
              "application/json": { "schema": { "description": "Identity account is not active" } }
            }
          },
          "423": {
            "description": "Password credential is locked",
            "content": {
              "application/json": { "schema": { "description": "Password credential is locked" } }
            }
          },
          "429": {
            "description": "Authentication rate limit exceeded",
            "content": {
              "application/json": {
                "schema": { "description": "Authentication rate limit exceeded" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "summary": "Refresh an authentication session",
        "tags": ["auth"],
        "description": "Rotates a refresh token, creates a replacement session, and returns a new refresh token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The currently valid refresh token."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session refreshed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Session refreshed successfully",
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "userId": { "type": "string", "format": "uuid" },
                        "sessionId": { "type": "string", "format": "uuid" },
                        "refreshToken": { "type": "string" }
                      },
                      "required": ["userId", "sessionId", "refreshToken"]
                    },
                    "requestId": { "type": "string" }
                  },
                  "required": ["data", "requestId"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid refresh request",
            "content": {
              "application/json": { "schema": { "description": "Invalid refresh request" } }
            }
          },
          "401": {
            "description": "Invalid refresh token, replayed token, inactive session, or expired session",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Invalid refresh token, replayed token, inactive session, or expired session"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logoutSession",
        "summary": "Log out an authentication session",
        "tags": ["auth"],
        "description": "Revokes the authentication session associated with the supplied refresh token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string",
                    "description": "The currently valid refresh token."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session logged out successfully",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Session logged out successfully",
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "sessionId": { "type": "string" },
                        "revoked": { "type": "boolean" }
                      },
                      "required": ["sessionId", "revoked"]
                    },
                    "requestId": { "type": "string" }
                  },
                  "required": ["data", "requestId"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid logout request",
            "content": {
              "application/json": { "schema": { "description": "Invalid logout request" } }
            }
          },
          "401": {
            "description": "Invalid refresh token",
            "content": {
              "application/json": { "schema": { "description": "Invalid refresh token" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/totp/setup": {
      "post": { "responses": { "200": { "description": "Default Response" } } }
    },
    "/api/v1/auth/totp/enable": {
      "post": { "responses": { "200": { "description": "Default Response" } } }
    },
    "/api/v1/auth/totp/disable": {
      "post": { "responses": { "200": { "description": "Default Response" } } }
    },
    "/api/v1/auth/totp/verify": {
      "post": { "responses": { "200": { "description": "Default Response" } } }
    },
    "/api/v1/auth/passkey/register/options": {
      "post": { "responses": { "200": { "description": "Default Response" } } }
    },
    "/api/v1/auth/passkey/register/verify": {
      "post": { "responses": { "200": { "description": "Default Response" } } }
    },
    "/api/v1/auth/passkey/authenticate/options": {
      "post": { "responses": { "200": { "description": "Default Response" } } }
    },
    "/api/v1/auth/passkey/authenticate/verify": {
      "post": { "responses": { "200": { "description": "Default Response" } } }
    },
    "/api/v1/auth/recovery/setup": {
      "post": { "responses": { "200": { "description": "Default Response" } } }
    },
    "/api/v1/auth/recovery/consume": {
      "post": { "responses": { "200": { "description": "Default Response" } } }
    },
    "/api/v1/auth/recovery/status": {
      "post": { "responses": { "200": { "description": "Default Response" } } }
    },
    "/api/v1/auth/recovery/revoke": {
      "post": { "responses": { "200": { "description": "Default Response" } } }
    }
  },
  "servers": [{ "url": "http://127.0.0.1:3000", "description": "Local development server" }],
  "tags": [
    { "name": "health", "description": "Health and service status" },
    { "name": "auth", "description": "Authentication and session management" },
    { "name": "security", "description": "TOTP, passkey, and account recovery" }
  ]
}
