# Runtime
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://localhost:5432/crypto_wallet

# Redis
REDIS_URL=redis://:local-valkey-change-me@localhost:6379

# Logging
LOG_LEVEL=info

# TOTP
TOTP_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
TOTP_ENCRYPTION_KEY_VERSION=v1

# Passkey
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Crypto Wallet
PASSKEY_ORIGIN=http://localhost:3000

# Kafka
KAFKA_BROKERS=127.0.0.1:19092
KAFKA_TOPIC=crypto-wallet.events
KAFKA_CLIENT_ID=crypto-wallet-api
KAFKA_CONSUMER_GROUP=crypto-wallet-api