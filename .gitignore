@"
# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
coverage/

# Turborepo
.turbo/

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Temporary files
*.tmp
*.temp

# Secrets / credentials
*.pem
*.key
*.p12
*.pfx
*.keystore
"@ | Set-Content .gitignore